{
  "name": "@typescriptprime/securereq",
  "type": "module",
  "version": "0.0.0",
  "description": "SecureReq is a lightweight utility for making secure HTTP requests, implemented in TypeScript",
  "keywords": [
    "https",
    "helper",
    "utilities",
    "http",
    "tls"
  ],
  "scripts": {
    "build": "tsc -p sources/tsconfig.json",
    "lint": "tsc --noEmit && oxlint sources tests",
    "test": "ava"
  },
  "exports": {
    ".": {
      "node": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*",
    "LICENSE",
    "README.md"
  ],
  "license": "Apache-2.0",
  "ava": {
    "files": [
      "tests/**/*.test.ts"
    ],
    "nodeArguments": [
      "--import=tsx"
    ],
    "workerThreads": false,
    "typescript": {
      "rewritePaths": {
        "@/": "./sources/"
      },
      "compile": false
    }
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TypescriptPrime/SecureReq.git"
  },
  "devDependencies": {
    "@ava/typescript": "^7.0.0",
    "@types/node": "^26.2.0",
    "ava": "^8.0.1",
    "https-proxy-agent": "^7.0.6",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "socks-proxy-agent": "^8.0.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
